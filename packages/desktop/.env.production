# 生产环境默认配置
# 此文件提交到 git,所有部署环境共享。个人覆盖请用 .env.local(gitignore)。

# 生产默认关闭微应用,避免未配置 entry 时尝试加载 localhost
# CI / 部署流水线必须显式注入 VITE_MICRO_APP_ENABLED=true 才启用
VITE_MICRO_APP_ENABLED=false

# 子应用产物的分发基址。entry 统一拼成 `<base>/<name>/index.html` —— 必须是 HTML,
# 不是裸 .js(qiankun 的 import-html-entry 只从 HTML 里解析 script)。
# 两种形态二选一:
#   内置安装包:bun run build:all 自动注入 app://microapps,不需要在这里写
#   CDN 独立部署:https://cdn.example.com/microapps
# 详见 docs/qiankun/06-build-and-deploy.md
VITE_MICRO_APP_ASSET_BASE=

# 单独覆盖某个子应用用,优先级高于上面的基址。生产部署时通过 CI 环境变量注入,这里留空。
# 例如:VITE_NOTES_APP_ENTRY=https://cdn.example.com/microapps/notes/v1.0.0/index.html
VITE_MEETING_RECORDING_APP_ENTRY=
VITE_NOTES_APP_ENTRY=
VITE_KNOWLEDGE_BASE_APP_ENTRY=
