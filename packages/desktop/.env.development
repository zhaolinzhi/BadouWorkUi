# 开发环境默认配置
# 此文件提交到 git,所有开发者共享。个人覆盖请用 .env.local(gitignore)。

# 开启微应用:本地 bun run dev 默认加载子应用
# 子应用需独立启动:cd packages/microapps/<name> && bun run dev
# VITE_MICRO_APP_ENABLED 默认行为在 isMicroAppEnabled() 中定义,详见 docs/qiankun/02-config.md
VITE_MICRO_APP_ENABLED=true

# 子应用 entry 留空时,getMicroAppConfig() 会回退到 dev port
# 想指向其它环境(测试/预发)时,覆盖下面任一变量
VITE_MICRO_APP_ASSET_BASE=
VITE_MEETING_RECORDING_APP_ENTRY=
VITE_NOTES_APP_ENTRY=
VITE_KNOWLEDGE_BASE_APP_ENTRY=
